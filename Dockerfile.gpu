# Autocut export worker on an NVIDIA GPU (AWS g6/g5/g4dn): the same server as Dockerfile, with an
# ffmpeg that encodes on the GPU (NVENC). Run with ROLE=worker WORKER_KINDS=render,preview.
# Filters and decoding stay on the CPU; the encode, the slow part, moves to the GPU.
FROM node:24-trixie-slim

# Debian's ffmpeg 7.1 is built with NVENC (the GPU driver itself is mounted in by the NVIDIA
# runtime) and libass for the captions.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && ffmpeg -hide_banner -encoders | grep -q h264_nvenc

WORKDIR /app
ENV NODE_ENV=production \
    PORT=8787 \
    AUTOCUT_DATA=/data \
    ROLE=worker \
    WORKER_KINDS=render,preview \
    FFMPEG_PATH=/usr/bin/ffmpeg \
    VIDEO_ENCODER=h264_nvenc \
    NVIDIA_DRIVER_CAPABILITIES=compute,video,utility \
    WHISPER_FALLBACK=0

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY src ./src
COPY fonts ./fonts
COPY legal ./legal
COPY supabase ./supabase
COPY app/src/lib/styles.json ./app/src/lib/styles.json

EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://localhost:'+process.env.PORT+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "src/server.js"]
