# Autocut server settings (Railway → each service → Variables). Never commit real values.
# Without any of these the server runs locally on its own: one process, videos and database on disk.

# Which part this service runs: api (the app talks to it), worker (cuts and exports), or all (both).
ROLE=all
# Jobs at once per worker copy. Cut workers mostly wait on Deepgram: 8–16. Export workers run ffmpeg:
# about one per two vCPU (e.g. 6 on 12 vCPU).
CONCURRENCY=1
# Which jobs this worker takes: cut, or render,preview (two pools sized differently). Unset: all.
WORKER_KINDS=
# Deepgram requests at once per worker copy. Keep (this × cut worker copies) under your Deepgram
# account's limit (about 50–100); extra requests wait and retry.
DEEPGRAM_MAX=8
# 0: if Deepgram fails after retrying, fail the cut (edit refunded) instead of slow Whisper on the worker.
WHISPER_FALLBACK=0
# Seconds Railway waits after asking a copy to stop, so it can finish or hand back its jobs.
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30

# Accounts (Supabase → Project Settings → API). The secret key never goes in the app.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# The shared database every server uses (Supabase → Connect → Session pooler, port 5432; with many
# worker copies use the Transaction pooler, port 6543, which serves more connections).
# Run supabase/migrations/20261016_shared_state.sql once in the SQL editor first.
DATABASE_URL=

# Video storage (Cloudflare → R2): bucket name, account id, and an R2 API token's key pair.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=autocut-videos

# Speech to text (Deepgram → API keys). Without it, Whisper runs on the worker (slow).
DEEPGRAM_API_KEY=
# 1 (default): Deepgram may not train on users' audio, as the privacy policy says. Costs more.
DEEPGRAM_MIP_OPT_OUT=1

# Payments
# Until 1, accounts that haven't paid keep the plan they picked (free beta). Set with EXPO_PUBLIC_PAYMENTS=1 in the app.
PAYMENTS_REQUIRED=0
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
# Which Whop plan is which, e.g. starter-monthly=plan_xxx,starter-yearly=plan_yyy,pro-monthly=…,ultimate-yearly=…
WHOP_PLANS=
WHOP_REDIRECT_URL=autocut://plan
# The Authorization value you set on the RevenueCat webhook (any long random string).
REVENUECAT_WEBHOOK_AUTH=

# Privacy policy and terms (shown at /privacy and /terms)
LEGAL_OPERATOR=
LEGAL_EMAIL=
LEGAL_COUNTRY=

# Autoscaling (on the api service): a Railway project token, and each worker pool as
# <cut|render|all>=<serviceId>:<jobs per copy>:<min copies>:<max copies>
RAILWAY_API_TOKEN=
SCALE_POOLS=

# Very large scale (AWS; see AWS.md). Unset on Railway.
# Job list and live progress in Redis instead of Postgres.
REDIS_URL=
# Our own speech-to-text (asr/), tried before Deepgram; ASR_MAX requests at once per worker.
ASR_URL=
ASR_TOKEN=
ASR_MAX=16
# libx264 (CPU), h264_nvenc (NVIDIA GPU, with FFMPEG_PATH pointing at an ffmpeg that has it), h264_videotoolbox (Mac).
VIDEO_ENCODER=libx264
FFMPEG_PATH=
# How often a running job reports progress (ms), and how long a stopping worker lets jobs finish (s).
PROGRESS_MS=1000
DRAIN_SECONDS=20

# Optional
MAX_UPLOAD_MB=1024
DB_POOL=3
CACHE_GB=8
