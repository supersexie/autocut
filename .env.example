# Autocut server settings (Railway → each service → Variables). Never commit real values.
# Without any of these the server runs locally on its own: one process, videos and database on disk.

# Which part this service runs: api (the app talks to it), worker (cuts and exports), or all (both).
ROLE=all
# Jobs at once per worker. Each uses every CPU core, so keep it at 1–2 and add worker replicas instead.
CONCURRENCY=1

# Accounts (Supabase → Project Settings → API). The secret key never goes in the app.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# The shared database every server uses (Supabase → Connect → Session pooler connection string).
# Run supabase/migrations/20261016_shared_state.sql once in the SQL editor first.
DATABASE_URL=

# Video storage (Cloudflare → R2): bucket name, account id, and an R2 API token's key pair.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=autocut-videos

# Speech to text (Deepgram → API keys). Without it, Whisper runs on the worker (slow).
DEEPGRAM_API_KEY=
# 1 (default): Deepgram may not train on users' audio, as the privacy policy says. Costs more.
DEEPGRAM_MIP_OPT_OUT=1

# Payments
# Until 1, accounts that haven't paid keep the plan they picked (free beta). Set with EXPO_PUBLIC_PAYMENTS=1 in the app.
PAYMENTS_REQUIRED=0
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
# Which Whop plan is which, e.g. starter-monthly=plan_xxx,starter-yearly=plan_yyy,pro-monthly=…,ultimate-yearly=…
WHOP_PLANS=
WHOP_REDIRECT_URL=autocut://plan
# The Authorization value you set on the RevenueCat webhook (any long random string).
REVENUECAT_WEBHOOK_AUTH=

# Privacy policy and terms (shown at /privacy and /terms)
LEGAL_OPERATOR=
LEGAL_EMAIL=
LEGAL_COUNTRY=

# Optional
MAX_UPLOAD_MB=1024
DB_POOL=5
CACHE_GB=8
