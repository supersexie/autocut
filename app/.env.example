# Copy to .env.local and fill in from Supabase › Project Settings › API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The deployed cutting server (Railway etc.). Leave unset in development to use the Mac running Expo.
# EXPO_PUBLIC_API_URL=https://autocut-server.up.railway.app

# Payments (leave unset for the free beta). Turn on together with PAYMENTS_REQUIRED=1 on the server.
# EXPO_PUBLIC_PAYMENTS=1
# RevenueCat → Project → API keys → the Apple App Store public key (appl_…).
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
# Set to 0 to hide the Whop web checkout (it only ever shows on the US App Store).
# EXPO_PUBLIC_WHOP=0
# EXPO_PUBLIC_WHOP_MANAGE_URL=https://whop.com/hub
